# Copy to .env and fill in. .env is git-ignored: keys live ONLY there.

# --- Supabase (tickets, handoffs, interaction_events, knowledge base) ---
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side secret key (service_role / sb_secret_...). Never expose to the browser.
SUPABASE_SERVICE_KEY=
# Set to 1 to run without Supabase using an in-memory store (dev/tests only;
# nothing persists across restarts).
USE_MEMORY_STORE=0

# --- Ollama (local LLM server) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenRouter ---
# No key here on purpose: each user enters their own key in the browser.
# It is held in page memory only and sent with each chat request.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Shown to OpenRouter as the calling app (optional)
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Gilead 311 Agent

# --- Web server (python run.py serve) ---
HOST=127.0.0.1
PORT=8311

# --- Docker (docker compose up -d --build) ---
# Host address the container's port 8311 is published on. 127.0.0.1 = this
# machine only (cloudflared); 0.0.0.0 = also reachable from the LAN.
PUBLISH_ADDRESS=127.0.0.1
# Where the container finds Ollama on the host
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

# --- Admin page (/admin) ---
# No login yet (prototype). 0 switches /admin and /api/admin off.
ADMIN_ENABLED=1
